#!/usr/bin/env bash
# Sync the upstream-owned method files into this project.
#
# Only files this project never hand-edits are touched. Your profiles, your
# planning documents, and your working agreement are never overwritten -- that
# separation is the whole reason the sync can be a plain overwrite instead of a
# merge, since a template repo shares no git history with the projects made
# from it.
#
# Fetches through `gh api`, which uses your existing GitHub auth and therefore
# works whether the upstream repo is private or public. Falls back to anonymous
# curl only when gh is unavailable AND the repo is public -- raw.githubusercontent
# returns 404 for private repos, which is why gh is the primary path.
#
# Usage:  bin/scaffold-update            # show what changed, then ask
#         bin/scaffold-update --check    # report only, change nothing
#         SCAFFOLD_UPSTREAM=owner/repo bin/scaffold-update
#
# Exit codes for --check: 0 up to date, 1 behind (any file to add, change, or
# delete), 2 could not determine -- upstream unreachable, or any single file
# could not be fetched. A full run that cannot fetch every file applies
# nothing and exits 2: SYNCED is upstream's own list, so a missing file is a
# fault, not a normal case. 3, in both modes: remote VERSION equals local
# VERSION yet a synced file differs -- upstream changed without a bump, or
# this copy was edited locally -- and nothing is applied until that is
# resolved (docs/specs/version-bump-check.md). Other errors keep their exit
# codes.
set -euo pipefail

# The arguments as given, kept for the self-update re-exec at the end.
ORIG_ARGS=("$@")

UPSTREAM="${SCAFFOLD_UPSTREAM:-Mannasolu/project-scaffolding}"
BRANCH="${SCAFFOLD_BRANCH:-main}"

# Upstream-owned. Anything added here must be a file no project edits.
SYNCED=(
  VERSION
  PROJECT-INSTRUCTIONS.md
  CLOSEOUT-RITUAL.md
  SECURITY-POSTURE.md
  bin/scaffold-update
  bin/scaffold-freshness
  bin/scaffold-brief-check
  docs/specs/component-spec-TEMPLATE.md
  docs/decisions/adr-TEMPLATE.md
  docs/session-logs/session-log-000-TEMPLATE.md
)

# Formerly upstream-owned files upstream has since dropped. A plain fetch
# failure can't tell "upstream deleted this on purpose" apart from "the
# network hiccuped" -- so retirement is a deliberate, reviewed list here,
# same discipline as SYNCED above, instead of inferred from a 404. A name
# only ever lands here because someone put it there on purpose; nothing
# about running this script adds to it.
RETIRED=(
  STARTUP-RITUAL.md
)

# Files no downstream project may ever have touched by this script, synced
# or retired: operator- and project-owned governance (ADR-004's partition),
# this repo's own planning/decision/log history, and (in the upstream repo
# itself) its private export tooling. Checked against SYNCED and RETIRED at
# every run, not just trusted at authoring time -- a bad edit to either
# array above must fail loudly here rather than silently deleting or
# overwriting something it was never allowed to touch.
#
# Naming note: this returns true for files that are NOT upstream-owned.
# Renaming it is_upstream_owned() would invert the meaning of every call
# site -- see WORKING-AGREEMENT.md, open item 1.
is_protected() {
  case "$1" in
    WORKING-AGREEMENT.md|OPERATOR-PROFILE.md|PROJECT-PROFILE.md) return 0 ;;
    docs/planning/*) return 0 ;;
    docs/session-logs/*) [[ "$1" == *-TEMPLATE.md ]] && return 1 || return 0 ;;
    docs/decisions/*) [[ "$1" == *-TEMPLATE.md ]] && return 1 || return 0 ;;
    export/*) return 0 ;;
    *) return 1 ;;
  esac
}

for f in "${SYNCED[@]}" "${RETIRED[@]}"; do
  if is_protected "$f"; then
    echo "refusing to run: '${f}' is in SYNCED or RETIRED but matches a" >&2
    echo "protected operator/project-owned pattern (ADR-004). Fix the array" >&2
    echo "in bin/scaffold-update before running again." >&2
    exit 1
  fi
done
for r in "${RETIRED[@]}"; do
  for s in "${SYNCED[@]}"; do
    if [ "$r" = "$s" ]; then
      echo "refusing to run: '${r}' is in both SYNCED and RETIRED." >&2
      exit 1
    fi
  done
done

CHECK_ONLY=false
[ "${1:-}" = "--check" ] && CHECK_ONLY=true

[ -f VERSION ] || { echo "run this from the project root"; exit 1; }

if command -v gh >/dev/null && gh auth status >/dev/null 2>&1; then
  MODE=gh
elif command -v curl >/dev/null; then
  MODE=curl
  echo "note: gh unavailable, falling back to anonymous fetch (public repos only)"
else
  echo "need either gh (authenticated) or curl"; exit 1
fi

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

flat() { echo "$1" | tr / _; }

# stderr is captured to a file rather than discarded. A fetch that fails for
# auth or network reasons and a fetch that fails because the file genuinely
# isn't upstream are indistinguishable without it -- and the caller below
# used to assert the second one either way.
fetch() {
  local path="$1" out="${TMP}/$(flat "$1")" err="${TMP}/$(flat "$1").err"
  if [ "$MODE" = gh ]; then
    gh api "repos/${UPSTREAM}/contents/${path}?ref=${BRANCH}" \
      -H "Accept: application/vnd.github.raw" > "$out" 2>"$err"
  else
    curl -fsSL "https://raw.githubusercontent.com/${UPSTREAM}/${BRANCH}/${path}" \
      -o "$out" 2>"$err"
  fi
}

show_fetch_error() {
  local err="${TMP}/$(flat "$1").err"
  [ -s "$err" ] && sed 's/^/       /' "$err" >&2
  return 0
}

# Name the repo being written to, in the first lines of output. This script
# overwrites governance files in whatever directory it is run from, and it
# used to announce only where it was reading from. A run started in the wrong
# repo was then indistinguishable from a correct one until the diffs appeared,
# several screens down -- by which point the approval prompt was the next
# thing on screen.
echo "target:   $(pwd)"
# No stderr redirect: a git error here is evidence, not noise. The fallback
# text is used only when the command itself exits non-zero.
ORIGIN_URL="$(git config --get remote.origin.url)" || ORIGIN_URL='(no origin remote)'
echo "          ${ORIGIN_URL}"
# Running inside the upstream repo itself: there is nothing to sync, and
# comparing its working tree to its own origin used to report "behind
# upstream" for ordinary uncommitted edits (open item 13).
if [[ "$ORIGIN_URL" =~ github\.com[:/]${UPSTREAM}(\.git)?$ ]]; then
  echo "this is the upstream repo (${UPSTREAM}); there is nothing to sync. Compare against origin with git status."
  exit 0
fi
echo "upstream: ${UPSTREAM}@${BRANCH} (via ${MODE})"
if fetch VERSION; then
  echo "local  version: $(cat VERSION)"
  echo "remote version: $(cat "${TMP}/VERSION")"
else
  echo "could not reach upstream" >&2
  show_fetch_error VERSION
  echo "  - private repo? gh must be authenticated: gh auth status" >&2
  echo "  - wrong name? current setting is ${UPSTREAM}" >&2
  # --check: 2, could not determine. A full run keeps its exit 1.
  if $CHECK_ONLY; then exit 2; fi
  exit 1
fi

CHANGED=()
NEW=()
FAILED=()
in_changed() {
  local x
  for x in "${CHANGED[@]}"; do [ "$x" = "$1" ] && return 0; done
  return 1
}
for f in "${SYNCED[@]}"; do
  if ! fetch "$f"; then
    echo "  ?  ${f} -- fetch failed:" >&2
    show_fetch_error "$f"
    FAILED+=("$f")
    continue
  fi
  t="${TMP}/$(flat "$f")"
  if [ ! -f "$f" ]; then
    echo "  +  ${f} -- new upstream"
    CHANGED+=("$f")
    NEW+=("$f")
  elif ! cmp -s "$f" "$t"; then
    echo "  M  ${f}"
    CHANGED+=("$f")
  fi
done

TO_DELETE=()
for f in "${RETIRED[@]}"; do
  if [ -f "$f" ]; then
    echo "  D  ${f} -- retired upstream, will be deleted"
    TO_DELETE+=("$f")
  fi
done

TOTAL=$(( ${#CHANGED[@]} + ${#TO_DELETE[@]} ))

# A fetch failure is a fault, not a normal case: SYNCED is upstream's own
# list. A file that was not compared cannot be called up to date, and nothing
# is applied -- a partial set would leave the project between two versions.
if [ "${#FAILED[@]}" -gt 0 ]; then
  echo >&2
  echo "${#FAILED[@]} file(s) could not be checked:" >&2
  printf '  %s\n' "${FAILED[@]}" >&2
  if ! $CHECK_ONLY; then
    echo "applying nothing." >&2
  fi
  exit 2
fi

# Equal VERSION with differing synced content is a fault, not an update. The
# bump is what tells every downstream that something changed; without it, this
# script cannot tell "upstream moved" from "this copy was edited" and must not
# overwrite either way. Upstream's own gate (bin/scaffold-version-check) is
# meant to make the first cause impossible; this is the refusal downstream if
# it ever gets through.
if [ "${#CHANGED[@]}" -gt 0 ] && [ "$(head -1 VERSION)" = "$(head -1 "${TMP}/VERSION")" ]; then
  echo >&2
  echo "VERSION $(head -1 VERSION) matches upstream, but ${#CHANGED[@]} synced file(s) differ:" >&2
  printf '  %s\n' "${CHANGED[@]}" >&2
  echo "Two possible causes: upstream changed without a VERSION bump (scaffolding" >&2
  echo "item 33), or this copy was edited locally. Applying nothing. Inspect each" >&2
  echo "path with: diff <(gh api -H 'Accept: application/vnd.github.raw' 'repos/${UPSTREAM}/contents/<path>?ref=${BRANCH}') <path>" >&2
  echo "then either restore the local copy or get upstream to bump VERSION." >&2
  exit 3
fi

if [ "$TOTAL" -eq 0 ]; then
  echo "up to date."
  exit 0
fi

if $CHECK_ONLY; then
  echo
  echo "${TOTAL} file(s) behind upstream. Run without --check to see diffs."
  if in_changed bin/scaffold-update; then
    echo "This list comes from the local copy of bin/scaffold-update; after syncing, run --check again."
  fi
  exit 1
fi

echo
for f in "${CHANGED[@]}"; do
  echo "=== ${f} ==="
  # A file that doesn't exist locally is diffed against /dev/null so its whole
  # content prints as additions. Diffing against the missing path made diff
  # error, and the old `2>/dev/null || true` swallowed both the error and the
  # fact that nothing had been shown -- so the approval prompt below was
  # answered for files whose content had never appeared on screen.
  if [ -f "$f" ]; then
    diff -u "$f" "${TMP}/$(flat "$f")" || true
  else
    echo "-- new file, full content follows --"
    diff -u /dev/null "${TMP}/$(flat "$f")" || true
  fi
  echo
done
for f in "${TO_DELETE[@]}"; do
  echo "=== ${f} ==="
  echo "-- retired upstream; will be deleted --"
  echo
done

if [ "${#NEW[@]}" -gt 0 ]; then
  echo "${#NEW[@]} of the ${TOTAL} change(s) are new files shown in full above."
fi
printf 'apply all %d change(s)? [y/N] ' "$TOTAL"
read -r reply
case "$reply" in
  y|Y)
    for f in "${CHANGED[@]}"; do
      mkdir -p "$(dirname "$f")"
      # mv, not cp: this loop can overwrite bin/scaffold-update while bash is
      # still reading it. A same-inode overwrite (cp) corrupts that read
      # mid-script; an atomic rename onto a new inode does not.
      cp "${TMP}/$(flat "$f")" "${f}.new"
      mv "${f}.new" "$f"
      echo "updated ${f}"
    done
    for f in "${TO_DELETE[@]}"; do
      rm -f "$f"
      echo "removed ${f}"
    done
    # Every synced script gets its execute bit, by pattern rather than by name:
    # a fetched file lands 644, and a named list here went stale the first time
    # a script was added to SYNCED (bin/scaffold-brief-check, scaffolding
    # session 023). No error suppression -- a chmod that fails should say so.
    for f in "${SYNCED[@]}"; do
      case "$f" in bin/*) [ -f "$f" ] && chmod +x "$f" ;; esac
    done
    # The reminder fires only when the file it is about changed; one that fired
    # on every run trained people to skip it. The command line below must match
    # CLOSEOUT-RITUAL.md byte for byte.
    if in_changed PROJECT-INSTRUCTIONS.md; then
      echo
      cat <<'EOF'
PROJECT-INSTRUCTIONS.md changed. Re-paste the Instructions field: print the
three files and their digest with

    cat PROJECT-INSTRUCTIONS.md OPERATOR-PROFILE.md PROJECT-PROFILE.md && printf '\ninstructions-digest: %s\n' "$(cat PROJECT-INSTRUCTIONS.md OPERATOR-PROFILE.md PROJECT-PROFILE.md | sha256sum | cut -d' ' -f1)"

and paste the output, replacing what is there.
EOF
    fi
    # Self-update: the apply loop above iterated this process's SYNCED -- the
    # old list. A file upstream added to that list has not been fetched yet, so
    # the new copy runs once more with the same arguments to finish the job. The
    # variable stops a second re-exec. An EXIT trap does not run across exec,
    # so the temp dir is removed here.
    if in_changed bin/scaffold-update && [ -z "${SCAFFOLD_UPDATE_REEXEC:-}" ]; then
      echo
      echo "bin/scaffold-update itself changed; re-running the new copy so its file list applies."
      rm -rf "$TMP"
      SCAFFOLD_UPDATE_REEXEC=1 exec bin/scaffold-update "${ORIG_ARGS[@]}"
    fi
    ;;
  *) echo "nothing changed." ;;
esac
